{
  "name": "@coti-io/pod-dapp-ports",
  "version": "0.1.0",
  "description": "Monorepo of dApp ports to PoD",
  "private": true,
  "scripts": {
    "test:sablier-payroll": "npm test --prefix sablier-payroll",
    "test:sablier-payroll-pod": "npm test --prefix sablier-payroll-pod",
    "test:sablier-payroll-pod:testnet:smoke": "npm run test:testnet:smoke --prefix sablier-payroll-pod",
    "test:sablier-payroll-pod:testnet": "npm run test:testnet --prefix sablier-payroll-pod",
    "deploy:sablier-payroll-pod:testnet": "npm run deploy:testnet --prefix sablier-payroll-pod",
    "deploy:sablier-payroll-pod:production": "npm run deploy:production --prefix sablier-payroll-pod",
    "deploy:sablier-payroll-pod:production:avax": "npm run deploy:production:avax --prefix sablier-payroll-pod",
    "check:sot-drift": "node scripts/check-sot-drift.mjs"
  }
}
